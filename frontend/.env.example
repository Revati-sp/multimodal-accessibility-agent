# AccessPilot frontend configuration. Copy to `.env.local` (git-ignored). Never put secrets here:
# every VITE_* value is compiled into the public JavaScript bundle.

# `mock`  = deterministic in-browser simulation, labelled "Demo mode — simulated data".
# `http`  = call the AccessPilot gateway (which itself is still a mock backend today).
VITE_TRANSPORT_MODE=mock

# Leave empty to use same-origin paths through the Vite dev proxy (recommended: the gateway has no CORS yet).
# Set to e.g. http://127.0.0.1:8000 only once the gateway allows this origin.
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api, /health and /ws.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# /ws/session is planned but NOT implemented by the gateway. Keep `false` until it exists;
# the client then polls GET /api/v1/tasks/{id} instead.
VITE_ENABLE_WEBSOCKET=false

# Polling interval (ms) used in http mode when no event stream is available.
VITE_POLL_INTERVAL_MS=3000
